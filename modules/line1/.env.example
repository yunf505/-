# ============================================================
# 线1 单证信息抽取 · 可选配置（agent 模式下默认全部不需要）
#
# 架构说明（docs/决策记录.md #D004）：
#   抽取由执行 agent 按 prompts/抽取规程 完成，无需任何密钥。
#   本文件仅在以下兜底场景才需要复制为 .env 并填写：
#   1) 脚本直调 LLM API 批量跑件；
#   2) 对方 agent 视觉能力弱，需 OCR 兜底。
# .env 已被 .gitignore 排除，永不入库。
# ============================================================

# --- LLM API（可选：脚本批处理模式，兼容 OpenAI Chat Completions 协议） ---
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=your-model-name

# --- DeepSeek 引擎（网页运行时抽取引擎，src/deepseek_extract.py / extract_engine --engine deepseek） ---
# 现场临时填 key 即可；base_url/model 一般不用改。
# 模型说明：营销名 "V4.1-Flash"，官方 API 调用名是 deepseek-flash；若控制台显示不同 ID，改这里。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- OCR 引擎（可选兜底；默认 agent_vision 不需要本文件） ---
# agent_vision（默认）| local（rapidocr，真实件唯一允许的兜底）| cloud（云OCR，仅自造/脱敏件！）
OCR_ENGINE=agent_vision
# 云 OCR 密钥（仅自造/脱敏件允许使用；真实单证严禁上云）
# CLOUD_OCR_KEY=

# --- 路径（一般不改；MAT 为测试资料绝对路径，只读） ---
# MAT_DIR=A:\个人文件\数联比赛项目\赛题二测试资料

# --- 调试 ---
DEBUG=false
